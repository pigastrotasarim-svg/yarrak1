generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id           Int      @id @default(1)
  phone1       String   @default("+90 242 255 06 98")
  phone2       String   @default("+90 242 255 06 98")
  email        String   @default("info@anadolulojistik.com")
  addressLine1 String   @default("Aşağıpazar Mahallesi 606 Sokak No: 5")
  addressLine2 String   @default("Korkuteli / Antalya")
  updatedAt    DateTime @updatedAt
}

model Shipment {
  id               String   @id @default(cuid())
  code             String   @unique
  firstName        String
  lastName         String
  customerName     String
  tcKimlik         String
  gsm              String
  receiverName     String?
  receiverGsm      String?
  originProvince   String
  originDistrict   String
  originMahalle    String   @default("")
  originStreet     String   @default("")
  originBuildingNo String   @default("")
  originFloor      String   @default("")
  originApartment  String   @default("")
  originAddress    String   @default("")
  originLat        Float
  originLng        Float
  destProvince     String
  destDistrict     String
  destMahalle      String   @default("")
  destStreet       String   @default("")
  destBuildingNo   String   @default("")
  destFloor        String   @default("")
  destApartment    String   @default("")
  destAddress      String   @default("")
  destLat          Float
  destLng          Float
  distanceKm       Float
  cargoType        String   @default("Genel kargo")
  cargoWeightKg    Float?
  packageCount     Int      @default(1)
  vehiclePlate     String?
  status           String   @default("YuklemeYapildi")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  departedAt       DateTime?
  estimatedAt      DateTime?
  deliveredAt      DateTime?
  events           TrackingEvent[]
}

model TrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  title      String
  location   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}
